@model IEnumerable<ContractMonthlyClaimSystem.Models.MonthlyClaims>
@{
    ViewData["Title"] = "My Claims";
}

<h4>My Claims</h4>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> You haven't submitted any claims yet.
        <a asp-action="Create" class="alert-link">Submit your first claim</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Claim ID</th>
                    <th>Period</th>
                    <th>Hours</th>
                    <th>Hourly Rate</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Submitted Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ClaimId</td>
                        <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.Month) @item.Year</td>
                        <td>@item.TotalHours.ToString("F1") hours</td>
                        <td>R @item.HourlyRate.ToString("F2")</td>
                        <td><strong>R @item.TotalAmount.ToString("F2")</strong></td>
                        <td>
                            @if (item.Status == "Approved")
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle"></i> @item.Status</span>
                            }
                            else if (item.Status == "Rejected")
                            {
                                <span class="badge bg-danger"><i class="fas fa-times-circle"></i> @item.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning"><i class="fas fa-clock"></i> @item.Status</span>
                            }
                        </td>
                        <td>@item.SubmittedDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.ClaimId" class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Submit New Claim
    </a>
</div>