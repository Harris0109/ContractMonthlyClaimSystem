@model ContractMonthlyClaimSystem.Models.MonthlyClaims
@{
    ViewData["Title"] = "Claim Details";
}

<h4>Claim Details</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Claim Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Claim ID:</dt>
                    <dd class="col-sm-8">@Model.ClaimId</dd>

                    <dt class="col-sm-4">Period:</dt>
                    <dd class="col-sm-8">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) @Model.Year</dd>

                    <dt class="col-sm-4">Hours Worked:</dt>
                    <dd class="col-sm-8">@Model.TotalHours.ToString("F1") hours</dd>

                    <dt class="col-sm-4">Hourly Rate:</dt>
                    <dd class="col-sm-8">R @Model.HourlyRate.ToString("F2")</dd>

                    <dt class="col-sm-4">Total Amount:</dt>
                    <dd class="col-sm-8"><strong>R @Model.TotalAmount.ToString("F2")</strong></dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status == "Approved")
                        {
                            <span class="badge bg-success"><i class="fas fa-check-circle"></i> @Model.Status</span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger"><i class="fas fa-times-circle"></i> @Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning"><i class="fas fa-clock"></i> @Model.Status</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Submitted Date:</dt>
                    <dd class="col-sm-8">@Model.SubmittedDate.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Supporting Documents Section -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Supporting Documents</h5>
            </div>
            <div class="card-body">
                @if (Model.Documents != null && Model.Documents.Any())
                {
                    <ul class="list-group">
                        @foreach (var doc in Model.Documents)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fas fa-file @(doc.OriginalFileName?.EndsWith(".pdf") == true ? "text-danger" : doc.OriginalFileName?.EndsWith(".docx") == true ? "text-primary" : "text-success")"></i>
                                    @doc.OriginalFileName
                                </div>
                                <a href="~/documents/@doc.FilePath" class="btn btn-sm btn-outline-primary" download>
                                    <i class="fas fa-download"></i> Download
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No supporting documents attached.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>
