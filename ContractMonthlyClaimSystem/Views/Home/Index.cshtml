@{
    ViewData["Title"] = "Contract Monthly Claim System";
}

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<div class="text-center">
    <h1 class="display-4 mb-4">Welcome to Contract Monthly Claim System</h1>

    @if (!SignInManager.IsSignedIn(User))
    {
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Get Started</h5>
                        <p class="card-text">Please log in to access the claim system.</p>
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary me-2">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-secondary">
                            <i class="fas fa-user-plus"></i> Register
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-tachometer-alt"></i> Dashboard</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="card text-white bg-success">
                                    <div class="card-body text-center">
                                        <i class="fas fa-plus fa-2x mb-2"></i>
                                        <h5>Submit Claim</h5>
                                        <a asp-controller="Claims" asp-action="Create" class="btn btn-light btn-sm">
                                            Create New
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-white bg-info">
                                    <div class="card-body text-center">
                                        <i class="fas fa-list fa-2x mb-2"></i>
                                        <h5>My Claims</h5>
                                        <a asp-controller="Claims" asp-action="Index" class="btn btn-light btn-sm">
                                            View All
                                        </a>
                                    </div>
                                </div>
                            </div>

                            @if (User.IsInRole("Coordinator") || User.IsInRole("Manager"))
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="card text-white bg-warning">
                                        <div class="card-body text-center">
                                            <i class="fas fa-tasks fa-2x mb-2"></i>
                                            <h5>Review Claims</h5>
                                            <a asp-controller="Claims" asp-action="Review" class="btn btn-light btn-sm">
                                                Start Review
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-4">
                            <h6>Quick Actions:</h6>
                            <div class="d-grid gap-2 d-md-block">
                                <a asp-controller="Claims" asp-action="Create" class="btn btn-primary me-2">
                                    <i class="fas fa-file-upload"></i> Submit New Claim
                                </a>
                                <a asp-controller="Claims" asp-action="Index" class="btn btn-outline-primary">
                                    <i class="fas fa-history"></i> View Claim History
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>