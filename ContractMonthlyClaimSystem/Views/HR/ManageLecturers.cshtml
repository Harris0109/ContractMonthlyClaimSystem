@model IEnumerable<ContractMonthlyClaimSystem.Models.Lecturer>
@{
    ViewData["Title"] = "Manage Lecturers";
}

<h4><i class="fas fa-users"></i> Manage Lecturers</h4>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <h5>No lecturers found</h5>
        <p>No lecturer data is currently available in the system.</p>
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Lecturer ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Hourly Rate</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lecturer in Model)
            {
                <tr>
                    <td>@lecturer.LecturerId</td>
                    <td>@lecturer.FullName</td>
                    <td>@lecturer.Email</td>
                    <td>R @lecturer.HourlyRate.ToString("F2")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
</div>
