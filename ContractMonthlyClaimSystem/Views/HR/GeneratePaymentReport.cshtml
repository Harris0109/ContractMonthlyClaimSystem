@model IEnumerable<ContractMonthlyClaimSystem.Models.MonthlyClaims>
@{
    ViewData["Title"] = "Payment Report";
}

<h4><i class="fas fa-file-invoice-dollar"></i> Payment Report</h4>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Payment Summary - Generated on @ViewBag.ReportDate</h5>
    </div>
    <div class="card-body">
        <p><strong>Total Claims:</strong> @Model.Count()</p>
        <p><strong>Total Amount:</strong> R @ViewBag.TotalAmount.ToString("F2")</p>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Claim ID</th>
            <th>Lecturer ID</th>
            <th>Period</th>
            <th>Hours</th>
            <th>Rate</th>
            <th>Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var claim in Model)
        {
            <tr>
                <td>@claim.ClaimId</td>
                <td>@claim.LecturerId</td>
                <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(claim.Month) @claim.Year</td>
                <td>@claim.TotalHours.ToString("F1")</td>
                <td>R @claim.HourlyRate.ToString("F2")</td>
                <td><strong>R @claim.TotalAmount.ToString("F2")</strong></td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
</div>
